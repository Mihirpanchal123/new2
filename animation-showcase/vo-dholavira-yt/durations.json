    "wav": "vo-dholavira-yt/line_116/trim.wav",
    "dur": 4.49,
    "trim": 3.41,
    "wps": 2.3460410557184748
  },
  {
    "i": 117,
    "txt": "तब भी इंसान ने प्रकृति की सीमाओं को समझकर, उनके साथ जीने का तरीका खोज लिया था।",
    "file": "vo-dholavira-yt/line_117/audio.mp3",
    "wav": "vo-dholavira-yt/line_117/trim.wav",
    "dur": 7.03,
    "trim": 5.98,
    "wps": 2.842809364548495
  },
  {
    "i": 118,
    "txt": "धोलावीरा सिर्फ़ एक प्राचीन शहर नहीं…",
    "file": "vo-dholavira-yt/line_118/audio.mp3",
    "wav": "vo-dholavira-yt/line_118/trim.wav",
    "dur": 3.67,
    "trim": 2.56,
    "wps": 2.34375
  },
  {
    "i": 119,
    "txt": "बल्कि उस सोच की कहानी है, जो आज भी हमें बहुत कुछ सिखा सकती है।",
    "file": "vo-dholavira-yt/line_119/audio.mp3",
    "wav": "vo-dholavira-yt/line_119/trim.wav",
    "dur": 6.29,
    "trim": 4.8,
    "wps": 3.125
  },
  {
    "i": 120,
    "txt": "अगर आपको यह कहानी पसंद आई, तो कमेंट में ज़रूर बताइए — धोलावीरा की कौन-सी बात आपको सबसे ज़्यादा हैरान करती है।",
