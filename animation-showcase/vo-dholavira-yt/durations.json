    "wav": "vo-dholavira-yt/line_50/trim.wav",
    "dur": 6.82,
    "trim": 5.75,
    "wps": 2.9565217391304346
  },
  {
    "i": 51,
    "txt": "ज़रा इस पूरे सिस्टम को एक साथ देखिए।",
