{
  "total": 3306,
  "lines": [
    {
      "si": 0,
      "txt": "कल्पना कीजिए…",
      "s": 0.5,
      "e": 1.49
    },
    {
      "si": 0,
      "txt": "आज से लगभग 5,000 साल पहले, गुजरात के एक सूखे इलाके में एक शहर बसा था,",
      "s": 2.04,
      "e": 7.81
    },
    {
      "si": 0,
      "txt": "जहाँ पानी की हर बूंद को बचाने के लिए शानदार इंजीनियरिंग का इस्तेमाल किया जाता था।",
      "s": 8.11,
      "e": 13.219999999999999
    },
    {
      "si": 1,
      "txt": "इस शहर का नाम था — धोलावीरा।",
      "s": 14.319999999999999,
      "e": 16.419999999999998
    },
    {
      "si": 1,
      "txt": "कच्छ के खडीर द्वीप पर बसा यह प्राचीन शहर,",
      "s": 16.72,
      "e": 19.599999999999998
    },
    {
      "si": 1,
      "txt": "हड़प्पा सभ्यता का एक महत्वपूर्ण केंद्र था।",
      "s": 19.9,
      "e": 22.709999999999997
    },
    {
      "si": 1,
      "txt": "लेकिन इसकी सबसे बड़ी खासियत इसकी इमारतें नहीं…",
      "s": 23.009999999999998,
      "e": 26.29
    },
    {
      "si": 1,
      "txt": "बल्कि पानी को संभालने का इसका तरीका था।",
      "s": 26.839999999999996,
      "e": 29.629999999999995
    },
    {
      "si": 2,
      "txt": "सोचिए, इस इलाके में सालभर बहने वाली कोई बड़ी नदी नहीं थी।",
      "s": 30.729999999999997,
      "e": 34.87
    },
    {
      "si": 2,
      "txt": "पानी के लिए यहाँ के लोग मानसून और मौसमी नालों पर निर्भर थे।",
      "s": 35.169999999999995,
      "e": 39.24999999999999
    },
    {
      "si": 2,
      "txt": "ऐसे में इतने बड़े शहर को पानी उपलब्ध कराना किसी चुनौती से कम नहीं था।",
      "s": 39.55,
      "e": 44.19
    },
    {
      "si": 3,
      "txt": "लेकिन धोलावीरा के लोगों ने इसका अनोखा समाधान निकाला।",
      "s": 45.29,
      "e": 48.95
    },
    {
      "si": 3,
      "txt": "उन्होंने विशाल जलाशय बनाए,",
      "s": 49.25,
      "e": 51.06
    },
    {
      "si": 3,
      "txt": "मौसमी नदियों के पानी को मोड़ा,",
      "s": 51.36,
      "e": 53.25
    },
    {
      "si": 3,
      "txt": "और बारिश के पानी को जमा करने के लिए विशेष रास्ते तैयार किए।",
      "s": 53.55,
      "e": 57.449999999999996
    },
    {
      "si": 3,
      "txt": "चट्टानों को काटकर कुएँ बनाए गए,",
      "s": 57.75,
      "e": 59.82
    },
    {
      "si": 3,
      "txt": "और पानी को एक जगह से दूसरी जगह पहुँचाने के लिए ड्रेनेज सिस्टम विकसित किए गए।",
      "s": 60.12,
      "e": 65.13
    },
    {
      "si": 4,
      "txt": "और सिर्फ पानी ही नहीं…",
      "s": 66.22999999999999,
      "e": 67.60999999999999
    },
    {
      "si": 4,
      "txt": "इस शहर की प्लानिंग भी कमाल की थी।",
      "s": 68.16,
      "e": 70.31
    },
    {
      "si": 4,
      "txt": "पूरा शहर अलग-अलग हिस्सों में बँटा था —",
      "s": 70.61,
      "e": 72.92999999999999
    },
    {
      "si": 4,
      "txt": "सिटाडेल, मिडिल टाउन और लोअर टाउन।",
      "s": 73.48,
      "e": 75.8
    },
    {
      "si": 4,
      "txt": "चारों तरफ मजबूत किलेबंदी और व्यवस्थित सड़कें थीं।",
      "s": 76.10000000000001,
      "e": 79.41000000000001
    },
    {
      "si": 5,
      "txt": "यह शहर लगभग 1,500 साल तक आबाद रहा।",
      "s": 80.51,
      "e": 83.54
    },
    {
      "si": 5,
      "txt": "यहाँ के अवशेष बताते हैं कि प्राचीन भारत में लोग सिर्फ शहर नहीं बनाते थे…",
      "s": 83.84,
      "e": 88.85000000000001
    },
    {
      "si": 5,
      "txt": "बल्कि प्रकृति और उपलब्ध संसाधनों को समझकर भविष्य की योजना भी बनाते थे।",
      "s": 89.4,
      "e": 94.57000000000001
    },
    {
      "si": 6,
      "txt": "और यही है धोलावीरा…",
      "s": 95.67,
      "e": 97.09
    },
    {
      "si": 6,
      "txt": "प्राचीन भारत की इंजीनियरिंग का एक ऐसा अध्याय, जिसे दुनिया आज भी पहचानती है।",
      "s": 97.64,
      "e": 102.89
    }
