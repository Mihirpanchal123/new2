    {
      "si": 5,
      "txt": "कल्पना कीजिए — कार्यशालाओं में काम करते कारीगर, बाज़ार की हलचल, और दूर से आते व्यापारी।",
      "s": 356.25,
      "e": 362.87
    },
    {
      "si": 5,
      "txt": "ध्यान रहे, ये दृश्य पुरातात्विक प्रमाणों पर आधारित कल्पना हैं।",
      "s": 363.19,
      "e": 367.48
    },
    {
      "si": 5,
      "txt": "लेकिन फिर… यह चहल-पहल धीरे-धीरे कम होने लगी।",
      "s": 367.8,
      "e": 372.05
    },
    {
      "si": 6,
      "txt": "कोई भी शहर हमेशा एक जैसा नहीं रहता।",
      "s": 375.37,
      "e": 378.18
    },
    {
      "si": 6,
      "txt": "धोलावीरा भी नहीं रहा।",
      "s": 378.5,
      "e": 380.03
    },
    {
      "si": 6,
      "txt": "पुरातत्वविदों ने यहाँ बसावट के कई अलग-अलग दौर पहचाने हैं।",
      "s": 380.35,
      "e": 384.41
    },
    {
      "si": 6,
      "txt": "एक समय के बाद, शहर की भव्यता कम होती दिखाई देती है।",
      "s": 384.73,
      "e": 388.64000000000004
    },
    {
      "si": 6,
      "txt": "कुछ समय के लिए यहाँ बसावट रुकी भी… और फिर लोग लौटे।",
      "s": 388.96000000000004,
      "e": 393.75000000000006
    },
    {
      "si": 6,
      "txt": "लेकिन बाद की बस्तियाँ छोटी और सादी थीं।",
      "s": 394.07000000000005,
      "e": 397.07000000000005
    },
    {
      "si": 6,
      "txt": "ऐसा क्यों हुआ?",
      "s": 397.39000000000004,
      "e": 398.33000000000004
    },
    {
      "si": 6,
      "txt": "इसका कोई एक, पक्का जवाब नहीं है।",
      "s": 398.95000000000005,
      "e": 401.35
    },
    {
      "si": 6,
      "txt": "कई शोध बताते हैं, कि इस दौर में जलवायु धीरे-धीरे और सूखी होती गई।",
      "s": 401.6700000000001,
      "e": 406.7800000000001
    },
    {
      "si": 6,
      "txt": "लंबे सूखे पड़े हो सकते हैं, और पानी के स्रोत बदले हो सकते हैं।",
      "s": 407.1000000000001,
      "e": 411.69000000000005
    },
    {
      "si": 6,
      "txt": "और जिस शहर की ज़िंदगी पानी पर टिकी थी, उसके लिए ये बदलाव बहुत बड़े थे।",
      "s": 412.0100000000001,
      "e": 417.3200000000001
    },
    {
      "si": 6,
      "txt": "कुछ विद्वान मानते हैं, कि व्यापार में आए बदलावों ने भी असर डाला होगा।",
      "s": 417.6400000000001,
      "e": 422.4300000000001
    },
    {
      "si": 6,
      "txt": "शायद लोग छोटे समूहों में, नई जगहों पर जाकर बसने लगे।",
      "s": 422.7500000000001,
      "e": 426.8300000000001
    },
    {
      "si": 6,
      "txt": "यानी धोलावीरा एक रात में ख़त्म नहीं हुआ।",
      "s": 427.1500000000001,
      "e": 429.9800000000001
    },
    {
      "si": 6,
      "txt": "यह धीरे-धीरे बदला… सिमटा… और आख़िरकार वीरान हो गया।",
      "s": 430.30000000000007,
      "e": 436.06000000000006
    },
    {
      "si": 6,
      "txt": "शोधकर्ता आज भी इसके कारणों का अध्ययन कर रहे हैं।",
      "s": 436.38000000000005,
      "e": 440.02000000000004
    },
    {
      "si": 6,
      "txt": "और फिर हज़ारों साल तक, यह शहर मिट्टी के नीचे सोता रहा।",
      "s": 440.34000000000003,
      "e": 444.28000000000003
    },
    {
      "si": 7,
      "txt": "स्थानीय लोग इस टीले को कोटडा टिंबा के नाम से जानते थे।",
      "s": 447.6,
      "e": 451.5
    },
    {
      "si": 7,
      "txt": "1968 में पुरातत्वविद जगत पति जोशी ने इस स्थल की पहचान की।",
      "s": 451.82000000000005,
      "e": 456.75000000000006
    },
    {
      "si": 7,
      "txt": "फिर 1989 से 2005 तक, भारतीय पुरातत्व सर्वेक्षण ने, आर. एस. बिष्ट के नेतृत्व में यहाँ बड़े पैमाने पर खुदाई की।",
      "s": 457.07000000000005,
      "e": 466.36000000000007
    },
    {
      "si": 7,
      "txt": "परत-दर-परत, यह भूला हुआ शहर फिर से सामने आया।",
      "s": 466.68000000000006,
      "e": 470.0300000000001
    },
    {
      "si": 7,
      "txt": "किलेबंदी, जलाशय, बाँध, घर, कार्यशालाएँ… और एक कब्रिस्तान भी।",
      "s": 470.3500000000001,
      "e": 476.0700000000001
    },
    {
      "si": 7,
      "txt": "उत्तरी द्वार के पास सिंधु लिपि के दस बड़े चिह्न भी मिले, जिन्हें अक्सर ‘साइनबोर्ड’ कहा जाता है।",
      "s": 476.3900000000001,
      "e": 482.5500000000001
    },
    {
      "si": 7,
      "txt": "यह लिपि आज तक पूरी तरह पढ़ी नहीं जा सकी है।",
      "s": 482.8700000000001,
      "e": 486.1800000000001
    },
    {
      "si": 7,
      "txt": "और फिर 2021 में, यूनेस्को ने धोलावीरा को विश्व धरोहर सूची में शामिल किया।",
      "s": 486.5000000000001,
      "e": 492.5200000000001
    },
    {
      "si": 7,
      "txt": "यह दर्जा पाने वाला यह भारत का पहला हड़प्पाई स्थल है।",
      "s": 492.8400000000001,
      "e": 496.5800000000001
    },
    {
      "si": 8,
      "txt": "आज, जब दुनिया के कई शहर पानी की कमी से जूझ रहे हैं…",
      "s": 499.9000000000001,
      "e": 503.80000000000007
    },
    {
      "si": 8,
      "txt": "धोलावीरा हमें एक पुराना, लेकिन ज़रूरी सबक़ याद दिलाता है।",
      "s": 504.4200000000001,
      "e": 508.6600000000001
    },
    {
      "si": 8,
      "txt": "बारिश को रोकना, सहेजना, और समझदारी से इस्तेमाल करना।",
      "s": 508.9800000000001,
      "e": 513.07
    },
    {
      "si": 8,
      "txt": "हज़ारों साल पहले, जब आधुनिक मशीनें नहीं थीं,",
      "s": 513.3900000000001,
      "e": 516.8000000000001
    },
    {
      "si": 8,
      "txt": "तब भी इंसान ने प्रकृति की सीमाओं को समझकर, उनके साथ जीने का तरीका खोज लिया था।",
      "s": 517.1200000000001,
      "e": 523.1000000000001
    },
    {
      "si": 8,
      "txt": "धोलावीरा सिर्फ़ एक प्राचीन शहर नहीं…",
      "s": 523.4200000000001,
      "e": 525.98
    },
    {
      "si": 8,
      "txt": "बल्कि उस सोच की कहानी है, जो आज भी हमें बहुत कुछ सिखा सकती है।",
      "s": 526.6,
      "e": 531.4
    },
    {
      "si": 8,
      "txt": "अगर आपको यह कहानी पसंद आई, तो कमेंट में ज़रूर बताइए — धोलावीरा की कौन-सी बात आपको सबसे ज़्यादा हैरान करती है।",
      "s": 531.72,
      "e": 539.9100000000001
    },
    {
      "si": 8,
      "txt": "और भारत के ऐसे ही भूले-बिसरे इतिहास के लिए, चैनल को सब्सक्राइब कीजिए।",
      "s": 540.23,
      "e": 545.4
    }
