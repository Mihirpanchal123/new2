  "lines": [
    {
      "si": 0,
      "txt": "गुजरात का कच्छ।",
      "s": 0.6,
      "e": 1.73
    },
    {
      "si": 0,
      "txt": "दूर-दूर तक फैली सफ़ेद, सूखी ज़मीन… और तेज़ धूप।",
